// 最低安装版本与构建SDK独立；SDK由本机Xcode提供。
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

// 开发占位Bundle ID；真机签名与上架前需改为用户账号下唯一标识。
PRODUCT_BUNDLE_IDENTIFIER = com.example.answersbook
PRODUCT_NAME = AnswersBook
MARKETING_VERSION = 0.14.1
CURRENT_PROJECT_VERSION = 41
CODE_SIGN_STYLE = Automatic

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = 答案之书
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = 将你选择的答案卡片保存到相册
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.entertainment
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait

ENABLE_PREVIEWS = YES
CLANG_ENABLE_MODULES = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks


// T18：采用已确认的双语书封图标V0.2。
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
